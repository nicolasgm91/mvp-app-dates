// Esquema relacional del sistema de autogestión de reservas del Centro Estético Violeta.
// Motor: SQLite (decisión de alcance del MVP) con Prisma ORM 7.
// Nota de compatibilidad: SQLite no soporta Decimal, por eso price usa Float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CLIENT
  ADMIN
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingChannel {
  WEB
  IN_PERSON
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  fullName          String        @map("full_name")
  // El teléfono es la llave de identidad del cliente: contacto actual y
  // principal canal del salón. Único cuando existe; los usuarios federados
  // pueden no tenerlo aún (SQLite admite varios NULL en un índice único).
  phone             String?       @unique
  role              Role          @default(CLIENT)
  authProvider      AuthProvider  @default(GOOGLE) @map("auth_provider")
  providerAccountId String?       @map("provider_account_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  appointments      Appointment[]

  @@map("users")
}

model Service {
  id              String        @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int           @map("duration_minutes")
  price           Float
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  appointments    Appointment[]

  @@map("services")
}

model Appointment {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  serviceId         String            @map("service_id")
  startTime         DateTime          @map("start_time")
  endTime           DateTime          @map("end_time")
  status            AppointmentStatus @default(CONFIRMED)
  channel           BookingChannel    @default(WEB)
  locationConfirmed Boolean           @default(false) @map("location_confirmed")
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([startTime, endTime, status])
  @@map("appointments")
}
